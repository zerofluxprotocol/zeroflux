{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PendingApproval",
  "description": "A request held for owner review. The body is encrypted in the vault; this record holds only metadata and a redacted preview.",
  "type": "object",
  "required": [
    "app_id",
    "approval_id",
    "approved_payload_hash",
    "categories",
    "created_at",
    "destination_id",
    "endpoint",
    "event_id",
    "expires_at",
    "policy_hash",
    "reason",
    "redacted_preview",
    "request_hash",
    "status"
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "approved_payload_hash": {
      "description": "Hash of the exact payload that would be sent if approved.",
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination_id": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_hash": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "redacted_preview": {
      "type": "string"
    },
    "request_hash": {
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "status": {
      "$ref": "#/definitions/PendingStatus"
    }
  },
  "definitions": {
    "PendingStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "DENIED",
        "CANCELLED",
        "EXPIRED",
        "CONSUMED"
      ]
    }
  }
}
