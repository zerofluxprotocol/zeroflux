{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransformMapEntry",
  "description": "Non-secret metadata about one reversible placeholder. The value itself lives only in the encrypted vault.",
  "type": "object",
  "required": [
    "category",
    "created_at",
    "expires_at",
    "key_id",
    "scope_id",
    "token"
  ],
  "properties": {
    "category": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "key_id": {
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "scope_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    }
  }
}
